<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- السماح بالاتصال المحلي لخدمات الاستراحة وسيرفر الإدارة وبوابات الراوتر -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">30.30.30.30</domain>
        <domain includeSubdomains="false">172.16.255.10</domain>
        <domain includeSubdomains="false">172.25.15.1</domain>
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">192.168.88.1</domain>
        <domain includeSubdomains="true">alqanas.cc.cd</domain>
    </domain-config>
</network-security-config>
